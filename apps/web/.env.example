VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Local same-origin proxy fallback:
VITE_API_BASE_URL=/v1
# This is the public half of the same VAPID pair used by push-dispatch. It may
# be included in the Vite bundle; never place server secrets in VITE_* values.
VITE_PUSH_PUBLIC_KEY=replace-with-vapid-public-key
# Production example:
# VITE_API_BASE_URL=https://your-project-ref.supabase.co/functions/v1
