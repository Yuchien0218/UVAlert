{
  "name": "sunshield-advisor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset",
    "supabase:functions:serve": "supabase functions serve",
    "education:generate": "node tools/education/generate-content.mjs",
    "region-data:build": "node tools/region-data/build-region-data.mjs",
    "region-data:verify": "node tools/region-data/build-region-data.mjs --verify",
    "lint": "eslint . && pnpm lint:css",
    "lint:css": "stylelint \"{packages,apps}/**/*.{css,vue}\"",
    "check": "pnpm typecheck && pnpm test && pnpm lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@turf/boolean-valid": "^7.3.5",
    "@turf/clean-coords": "^7.3.5",
    "@turf/rewind": "^7.3.5",
    "@turf/simplify": "^7.3.5",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "adm-zip": "^0.6.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.10.0",
    "fake-indexeddb": "^6.2.4",
    "globals": "^17.11.0",
    "happy-dom": "^20.0.0",
    "postcss": "^8.5.23",
    "postcss-html": "^2.0.0",
    "proj4": "^2.21.0",
    "shapefile": "^0.6.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "subset-font": "^2.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "vue": "^3.5.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
