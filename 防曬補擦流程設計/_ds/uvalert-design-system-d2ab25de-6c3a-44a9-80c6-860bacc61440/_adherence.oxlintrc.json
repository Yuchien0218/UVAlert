        "selector": "JSXOpeningElement[name.name='BrandMark'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:mark|lockup|dark)$/]",
        "message": "<BrandMark> variant must be one of 'mark' | 'lockup' | 'dark'."
