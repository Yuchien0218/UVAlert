{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/education/**",
              "components/feedback/**",
              "components/gear/**",
              "components/more/**",
              "components/navigation/**",
              "components/reminder/**",
              "components/setup/**",
              "components/uv/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:LXGW WenKai TC|Inter|Noto Sans TC|Noto Sans Mono))/i]",
        "message": "Font not provided by the design system. Available: LXGW WenKai TC, Inter, Noto Sans TC, Noto Sans Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|children|className|style|key|ref|className|style|children)$/]",
        "message": "<AppCard> doesn't accept that prop. Declared props: as, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BadgePill'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|className|style|key|ref|className|style|children)$/]",
        "message": "<BadgePill> doesn't accept that prop. Declared props: variant, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BadgePill'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|unverified)$/]",
        "message": "<BadgePill> variant must be one of 'default' | 'unverified'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onSelect|iconBase|style|key|ref|className|style|children)$/]",
        "message": "<BottomNav> doesn't accept that prop. Declared props: active, onSelect, iconBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNav'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:reminder|gear|more)$/]",
        "message": "<BottomNav> active must be one of 'reminder' | 'gear' | 'more'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|actions|onClose|iconBase|style|key|ref|className|style|children)$/]",
        "message": "<BottomSheet> doesn't accept that prop. Declared props: title, children, actions, onClose, iconBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:logoBase|trailing|style|key|ref|className|style|children)$/]",
        "message": "<BrandHeader> doesn't accept that prop. Declared props: logoBase, trailing, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|basePath|className|style|key|ref|className|style|children)$/]",
        "message": "<BrandMark> doesn't accept that prop. Declared props: variant, size, basePath, className, style."
